{
  "name": "probyu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "contract:check": "pnpm contract:validate && pnpm contract:generate && git diff --exit-code -- contracts/openapi/generated",
    "contract:generate": "openapi-ts -f openapi-ts.config.ts",
    "contract:validate": "tsx scripts/check-contracts.ts",
    "db:down": "docker compose -f infra/compose.yaml down",
    "db:migrate": "pnpm --filter @probyu/backend db:migrate",
    "db:seed": "pnpm --filter @probyu/backend db:seed",
    "db:up": "docker compose -f infra/compose.yaml up -d postgres",
    "db:verify": "pnpm --filter @probyu/backend db:verify",
    "dev": "concurrently -k -n api,web,worker -c blue,green,magenta \"pnpm dev:api\" \"pnpm dev:web\" \"pnpm dev:worker\"",
    "dev:api": "pnpm --filter @probyu/backend dev:api",
    "dev:web": "pnpm --filter @probyu/web dev",
    "dev:worker": "pnpm --filter @probyu/backend dev:worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @probyu/web test:e2e",
    "test:integration": "pnpm --filter @probyu/backend test:integration",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r --if-present typecheck",
    "verify": "pnpm contract:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "db:m2:prepare": "pnpm --filter @probyu/backend exec tsx src/db/family-prepare.ts",
    "test:m2": "pnpm --filter @probyu/backend exec vitest run src/db/family.integration.test.ts",
    "test:e2e:m2": "pnpm --filter @probyu/web exec playwright test --config playwright.m2.config.ts",
    "dev:m2": "tsx scripts/dev-m2.ts"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@apidevtools/swagger-parser": "13.0.0",
    "@hey-api/openapi-ts": "0.99.0",
    "@types/node": "24.13.4",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0",
    "yaml": "2.9.1"
  }
}
